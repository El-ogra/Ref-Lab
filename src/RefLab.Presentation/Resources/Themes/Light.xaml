<!--
    The light theme of the Ref Lab presentation layer.

    The palette follows the reference product: a dark blue application chrome,
    a light working surface, and a small number of saturated accent colours
    used for the action buttons of the command rows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette -->
    <Color x:Key="ChromeColor">#FF1F4E79</Color>
    <Color x:Key="PanelColor">#FFDCE6F1</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#FF2E7D32</Color>
    <Color x:Key="WarningColor">#FFE65100</Color>
    <Color x:Key="DangerColor">#FFB71C1C</Color>
    <Color x:Key="TextColor">#FF1A1A1A</Color>
    <Color x:Key="MutedTextColor">#FF5A5A5A</Color>

    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <!-- Typography -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="ArabicFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="UiFontSize">13</sys:Double>
    <sys:Double x:Key="HeadingFontSize">17</sys:Double>

    <!-- Base text -->
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- Arabic surfaces: the Arabic panel of the patient work screen -->
    <Style x:Key="ArabicLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ArabicValueStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,2" />
    </Style>

    <!-- Containers -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="ChromePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Inputs -->
    <Style x:Key="LabTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="LabComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style x:Key="LabCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Buttons: the action rows of the working screens -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBrush}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- Arabic command buttons: the action row of the patient work screen -->
    <Style x:Key="ArabicActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}" />
    </Style>

    <!-- Grids -->
    <Style x:Key="LabDataGridStyle" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#FFF4F8FC" />
    </Style>

    <Style x:Key="LabListViewStyle" TargetType="ListView">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

</ResourceDictionary>
