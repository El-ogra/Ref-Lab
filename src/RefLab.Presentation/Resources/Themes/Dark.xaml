<!--
    The dark theme of the Ref Lab presentation layer.

    The dark theme overrides only the palette and the base text styles; every
    layout style is inherited from the light theme, so a surface keeps exactly
    the same structure whichever theme is applied.

    The palette therefore carries the same roles as the light theme, and the
    same number of them: a role that exists in one theme and not in the other
    would leave a style without a colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="ChromeColor">#FF102A43</Color>
    <Color x:Key="PanelColor">#FF1B3A57</Color>
    <Color x:Key="SurfaceColor">#FF14293D</Color>
    <Color x:Key="AccentColor">#FF43A047</Color>
    <Color x:Key="WarningColor">#FFFB8C00</Color>
    <Color x:Key="DangerColor">#FFE53935</Color>
    <Color x:Key="TextColor">#FFF2F5F8</Color>
    <Color x:Key="MutedTextColor">#FFB0BEC5</Color>

    <Color x:Key="HeaderBandColor">#FFB8912A</Color>
    <Color x:Key="ActionGreenColor">#FF558B2F</Color>
    <Color x:Key="ActionOrangeColor">#FFC07A18</Color>
    <Color x:Key="ActionBlueColor">#FF2A5F8F</Color>
    <Color x:Key="GridHeaderColor">#FF1F5C97</Color>
    <Color x:Key="FieldFillColor">#FF3B3A1C</Color>
    <Color x:Key="FieldLabelColor">#FF173A5E</Color>
    <Color x:Key="SurfaceAltColor">#FF1B3149</Color>
    <Color x:Key="BorderColor">#FF3E7CB1</Color>
    <Color x:Key="ChromeDeepColor">#FF0B1D30</Color>

    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="HeaderBandBrush" Color="{StaticResource HeaderBandColor}" />
    <SolidColorBrush x:Key="ActionGreenBrush" Color="{StaticResource ActionGreenColor}" />
    <SolidColorBrush x:Key="ActionOrangeBrush" Color="{StaticResource ActionOrangeColor}" />
    <SolidColorBrush x:Key="ActionBlueBrush" Color="{StaticResource ActionBlueColor}" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="{StaticResource GridHeaderColor}" />
    <SolidColorBrush x:Key="FieldFillBrush" Color="{StaticResource FieldFillColor}" />
    <SolidColorBrush x:Key="FieldLabelBrush" Color="{StaticResource FieldLabelColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ChromeDeepBrush" Color="{StaticResource ChromeDeepColor}" />

    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
