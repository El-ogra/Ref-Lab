<Window x:Class="RefLab.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ref Lab"
        Width="1360"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        FlowDirection="LeftToRight"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource UiFontSize}">

    <Window.InputBindings>
        <KeyBinding Key="F7" Command="{Binding NavigateCommand}" CommandParameter="SendOut" />
        <KeyBinding Key="Back" Command="{Binding BackCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- The module toolbar: the legacy product carried the same strip across every window. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{StaticResource App.Title}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="4,0,18,0" />

                    <Button Content="{StaticResource Screen.PatientWork}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="PatientWork" />
                    <Button Content="{StaticResource Screen.TestCatalogue}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="TestCatalogue" />
                    <Button Content="{StaticResource Screen.CatalogueAdministration}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="CatalogueAdministration" />
                    <Button Content="{StaticResource Screen.SendOut}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="SendOut" />
                    <Button Content="{StaticResource Screen.Microbiology}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Microbiology" />
                    <Button Content="{StaticResource Screen.Accounting}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Accounting" />
                    <Button Content="{StaticResource Screen.PartiesPricing}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="PartiesPricing" />
                    <Button Content="{StaticResource Screen.ReportSetup}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="ReportSetup" />
                    <Button Content="{StaticResource Screen.LaboratorySettings}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="LaboratorySettings" />
                    <Button Content="{StaticResource Screen.OperatorAdministration}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="OperatorAdministration" />
                    <Button Content="{StaticResource Screen.Statistics}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Statistics" />
                    <Button Content="{StaticResource Screen.Audit}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Audit" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding OperatorName}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Content="{StaticResource Command.Logout}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding SignOutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The status strip -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DeepChromePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Width="120"
                             Height="12"
                             Margin="0,0,10,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Foreground="{StaticResource AccentBrush}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" />

                <!--
                    The operator and database strip.

                    The laboratory's own screens carry the signed-in operator
                    and the database they work against in a permanent strip,
                    so that the operator can always see who is signed in and
                    which database the work is going into.
                -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,2,0">
                        <Run Text="{StaticResource Shell.UserName}" />
                        <Run Text=" :" />
                    </TextBlock>
                    <TextBlock Text="{Binding OperatorName}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <TextBlock Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0">
                        <Run Text="{StaticResource Shell.LastLogin}" />
                        <Run Text=" :" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastSignInText}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <TextBlock Text="{StaticResource Shell.Database}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <TextBlock Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0">
                        <Run Text="{StaticResource Shell.Today}" />
                        <Run Text=" :" />
                    </TextBlock>
                    <TextBlock Text="{Binding TodayText}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The navigation region: one screen at a time. -->
        <ContentControl Grid.Column="0"
                        Content="{Binding CurrentView}"
                        Background="{StaticResource SurfaceBrush}" />
    </DockPanel>
</Window>
