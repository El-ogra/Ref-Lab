<UserControl x:Class="RefLab.Presentation.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DataContext="{d:DesignInstance Type=vm:SignInViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <Grid>
        <Border Style="{StaticResource ChromePanelStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{StaticResource App.Title}"
                           Style="{StaticResource HeadingTextStyle}"
                           Foreground="White" />

                <TextBlock Text="Sign in to the laboratory"
                           Style="{StaticResource MutedTextStyle}"
                           Foreground="White"
                           Margin="0,0,0,16" />

                <TextBlock Text="User name"
                           Style="{StaticResource ArabicLabelStyle}"
                           Foreground="White"
                           HorizontalAlignment="Left" />
                <TextBox Style="{StaticResource LabTextBoxStyle}"
                         Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="User name" />

                <TextBlock Text="{StaticResource Field.Password}"
                           Style="{StaticResource ArabicLabelStyle}"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0" />
                <Grid>
                    <PasswordBox x:Name="MaskedPasswordBox"
                                 PasswordChanged="MaskedPasswordBox_PasswordChanged"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding PasswordVisibilityGlyph}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand" />
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,10,0,0" />

                <Button Content="Login"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding SignInCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>