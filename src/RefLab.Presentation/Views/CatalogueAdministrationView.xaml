<UserControl x:Class="RefLab.Presentation.Views.CatalogueAdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CatalogueAdministrationViewModel}"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <TextBlock Text="{StaticResource Screen.CatalogueAdministration}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TabControl Margin="8">
                <TabItem Header="{StaticResource Panel.TestDefinitions}" Style="{StaticResource LabTabItemStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Add}" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateTestCommand}" />
                            <Button Content="{StaticResource Command.Edit}" Style="{StaticResource ActionButtonStyle}" Command="{Binding UpdateTestCommand}" />
                            <Button Content="{StaticResource Command.Refresh}" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadCommand}" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding TestDefinitions}" SelectedItem="{Binding SelectedTest, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Column.Code}" Binding="{Binding Code}" Width="70" />
                                <DataGridTextColumn Header="{StaticResource Column.TestName}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{StaticResource Column.SimpleName}" Binding="{Binding SimpleName}" Width="130" />
                                <DataGridTextColumn Header="{StaticResource Column.SubGroupCode}" Binding="{Binding SubGroupCode}" Width="80" />
                                <DataGridTextColumn Header="{StaticResource Column.PatientPrice}" Binding="{Binding PatientPrice}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{StaticResource Panel.ReferenceRanges}" Style="{StaticResource LabTabItemStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Add}" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateReferenceRangeCommand}" />
                            <Button Content="{StaticResource Command.Edit}" Style="{StaticResource ActionButtonStyle}" Command="{Binding UpdateReferenceRangeCommand}" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding ReferenceRanges}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Column.TestCode}" Binding="{Binding TestCode}" Width="80" />
                                <DataGridTextColumn Header="{StaticResource Column.SexScope}" Binding="{Binding SexScope}" Width="90" />
                                <DataGridTextColumn Header="{StaticResource Column.AgeUnit}" Binding="{Binding AgeUnit}" Width="90" />
                                <DataGridTextColumn Header="{StaticResource Column.Range}" Binding="{Binding RangeText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{StaticResource Panel.UnitsAndConversions}" Style="{StaticResource LabTabItemStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Save}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveUnitsAndConversionsCommand}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding Units}" Margin="0,0,4,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Name}" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Column="1" Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding Conversions}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.TestName}" Binding="{Binding TestSimpleName}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.FromUnit}" Binding="{Binding FromUnit}" Width="90" />
                                    <DataGridTextColumn Header="{StaticResource Column.ToUnit}" Binding="{Binding ToUnit}" Width="90" />
                                    <DataGridTextColumn Header="{StaticResource Column.Factor}" Binding="{Binding Factor}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{StaticResource Panel.Abbreviations}" Style="{StaticResource LabTabItemStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Add}" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateAbbreviationCommand}" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding Abbreviations}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Column.Abbreviation}" Binding="{Binding Text}" Width="*" />
                                <DataGridTextColumn Header="{StaticResource Column.Meaning}" Binding="{Binding Meaning}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{StaticResource Panel.SubGroups}" Style="{StaticResource LabTabItemStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Add}" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateSubGroupCommand}" />
                            <Button Content="{StaticResource Command.Refresh}" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadCommand}" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding SubGroups}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Column.Code}" Binding="{Binding Code}" Width="80" />
                                <DataGridTextColumn Header="{StaticResource Column.Name}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{StaticResource Column.ArabicName}" Binding="{Binding ArabicName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!--
                    The custom test-group editor.

                    The reference system composes a new test group from the
                    membership of an existing one: the operator picks the source
                    group, copies its tests, removes the ones that do not
                    belong, names the new group and saves it.
                -->
                <TabItem Header="{StaticResource Panel.CustomTestGroups}" Style="{StaticResource LabTabItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The groups that exist, and the one being copied from -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.CustomGroups}"
                                       Style="{StaticResource SubHeadingTextStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}"
                                      ItemsSource="{Binding SubGroups}"
                                      SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Code}" Binding="{Binding Code}" Width="80" />
                                    <DataGridTextColumn Header="{StaticResource Column.Name}" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- The group being composed -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.SelectedTest}"
                                       Style="{StaticResource SubHeadingTextStyle}" />

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{StaticResource Panel.CustomTestGroupName}"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource LabFieldTextBoxStyle}"
                                         Text="{Binding NewTestGroupName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <Button Content="{StaticResource Command.AddAllTestsInGroup}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding AddAllTestsInGroupCommand}" />
                                <Button Content="{StaticResource Command.Delete}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding RemoveGroupTestCommand}" />
                                <Button Content="{StaticResource Command.All}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding AddEveryTestToGroupCommand}" />
                                <Button Content="{StaticResource Command.Save}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding CreateTestGroupCommand}" />
                            </StackPanel>

                            <DataGrid Style="{StaticResource LabDataGridStyle}"
                                      ItemsSource="{Binding TestGroupTests}"
                                      SelectedItem="{Binding SelectedGroupTest, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.TestCode}" Binding="{Binding Code}" Width="80" />
                                    <DataGridTextColumn Header="{StaticResource Column.TestName}" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
