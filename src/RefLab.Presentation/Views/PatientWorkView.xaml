<UserControl x:Class="RefLab.Presentation.Views.PatientWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             xmlns:controls="clr-namespace:RefLab.Presentation.Views.Controls"
             xmlns:panels="clr-namespace:RefLab.Presentation.Views.Panels"
             d:DataContext="{d:DesignInstance Type=vm:PatientWorkViewModel}"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <!--
        The patient work screen.

        The screen keeps the three surfaces the reference product held together
        in one window: the English catalogue panel on the left, the Arabic
        patient panel on the right, and the results of the ordered tests
        underneath. The application chrome stays left to right; the direction
        of the Arabic patient panel is set on the panel itself.

        The binding keyboard shortcuts are declared here:
          F8  review the selected result
          F9  save the result that is being entered
          F11 prepare the print operation
          F12 produce the report
        F7, the send-out shortcut, is bound on the shell because it moves to a
        different screen.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="F8" Command="{Binding ReviewCommand}" />
        <KeyBinding Key="F9" Command="{Binding SaveResultCommand}" />
        <KeyBinding Key="F11" Command="{Binding PreparePrintCommand}" />
        <KeyBinding Key="F12" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>

    <DockPanel>

        <!-- The top command bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{StaticResource Ar.PatientPanel.RequestedTests}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding ClearPatientCommand}" />
                <Button Content="{StaticResource Command.Search}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding SearchCommand}" />
                <Button Content="{StaticResource Command.Edit}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding OpenSelectedPatientCommand}" />
                <Button Content="{StaticResource Command.Save}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding RegisterCommand}" />
                <Button Content="{StaticResource Command.Barcode}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding GenerateBarcodeCommand}" />
                <Button Content="{StaticResource Command.History}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding LoadCasesCommand}" />
                <Button Content="{StaticResource Command.FollowUpCase}"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding LoadCasesCommand}" />
                <Button Content="{StaticResource Command.Print}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding PrintCommand}" />
            </StackPanel>
        </Border>

        <!-- The working area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- The English catalogue panel -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelStyle}">
                <controls:CataloguePanelControl DataContext="{Binding Catalogue}" />
            </Border>

            <!-- The Arabic patient panel -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelStyle}">
                <controls:PatientPanelControl DataContext="{Binding Patient}" />
            </Border>

            <!-- The search -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{StaticResource Field.SearchTerm}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource LabTextBoxStyle}" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="{StaticResource Field.Phone}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Style="{StaticResource LabTextBoxStyle}" Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="4" Content="{StaticResource Command.Search}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SearchCommand}" />
                    <DataGrid Grid.Column="5" Style="{StaticResource LabDataGridStyle}"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                              MaxHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Column.Name}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{StaticResource Column.Code}" Binding="{Binding Id}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- The results -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorderStyle}">
                        <TextBlock Text="{StaticResource Panel.Results}"
                                   Style="{StaticResource BaseTextStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FieldLabelBrush}"
                                   TextAlignment="Center" />
                    </Border>
                    <controls:ResultsGridControl />
                </DockPanel>
            </Border>

            <!-- The result entry and the in-place panels -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{StaticResource Panel.EnterResult}" Style="{StaticResource HeadingTextStyle}" HorizontalAlignment="Left" />
                        <TextBlock Text="{StaticResource Field.ResultValue}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ResultValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{StaticResource Field.ResultUnit}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ResultUnit, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{StaticResource Field.Comment}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ResultComment, UpdateSourceTrigger=PropertyChanged}" />

                        <!--
                            The specimen origin.

                            The reference system records a specimen that was
                            taken outside the laboratory as the standard comment
                            of the result, and prints that comment under the
                            analyte on the report.
                        -->
                        <CheckBox Style="{StaticResource LabCheckBoxStyle}"
                                  Content="{StaticResource Field.SampleTakenOutsideLab}"
                                  IsChecked="{Binding SampleTakenOutsideLab}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{StaticResource Command.Save}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveResultCommand}" />
                            <Button Content="{StaticResource Command.Review}" Style="{StaticResource PrimaryActionButtonStyle}" Command="{Binding ReviewCommand}" />
                            <Button Content="{StaticResource Command.HandOver}" Style="{StaticResource ActionButtonStyle}" Command="{Binding HandOverCommand}" />
                        </StackPanel>

                        <!--
                            The print settings.

                            The reference system prints the destination, the
                            output category and the number of copies on the
                            working screen, beside the result entry.
                        -->
                        <Border Style="{StaticResource PanelHeaderBorderStyle}">
                            <TextBlock Text="{StaticResource Panel.PrintSettings}"
                                       Style="{StaticResource BaseTextStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FieldLabelBrush}"
                                       TextAlignment="Center" />
                        </Border>

                        <TextBlock Text="{StaticResource Field.DestinationDirectory}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{StaticResource Field.CopyCount}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding CopyCount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{StaticResource Field.ReferringLaboratory}" Style="{StaticResource BaseTextStyle}" />
                        <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding SelectedLaboratory, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Style="{StaticResource LabComboBoxStyle}"
                                  ItemsSource="{x:Static vm:EnumSource.ReportCategoryValues}"
                                  SelectedItem="{Binding ReportCategory}" />
                    </StackPanel>

                    <!--
                        The review-verification group.

                        The reference system shows, beside the result entry, the
                        state of every requested test, so that the operator can
                        see at a glance which results are still unreviewed and
                        which have already been released.
                    -->
                    <Border Style="{StaticResource PanelHeaderBorderStyle}">
                        <TextBlock Text="{StaticResource Panel.ReviewVerification}"
                                   Style="{StaticResource BaseTextStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FieldLabelBrush}"
                                   TextAlignment="Center" />
                    </Border>

                    <DataGrid Style="{StaticResource LabDataGridStyle}"
                              ItemsSource="{Binding Tests}"
                              SelectedItem="{Binding SelectedTest, Mode=TwoWay}"
                              MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Column.TestAbbreviation}" Binding="{Binding TestSimpleName}" Width="*" />
                            <DataGridCheckBoxColumn Header="{StaticResource Column.Verified}" Binding="{Binding IsReviewed}" Width="70" />
                            <DataGridCheckBoxColumn Header="{StaticResource Column.Printed}" Binding="{Binding IsPrinted}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TabControl>
                        <TabItem Header="{StaticResource Panel.MethodSheet}" Style="{StaticResource LabTabItemStyle}">
                            <panels:MethodSheetPanelView DataContext="{Binding MethodSheet}" />
                        </TabItem>
                        <TabItem Header="{StaticResource Panel.Derivation}" Style="{StaticResource LabTabItemStyle}">
                            <panels:DerivationPanelView DataContext="{Binding Derivation}" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The bottom action row -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ChromePanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{StaticResource Ar.PatientPanel.RequestedTests}" Style="{StaticResource ArabicActionButtonStyle}" Command="{Binding OrderTestsCommand}" />
                <Button Content="{StaticResource Ar.Command.Clear}" Style="{StaticResource ArabicActionButtonStyle}" Command="{Binding ClearPatientCommand}" />
                <Button Content="{StaticResource Ar.Command.Edit}" Style="{StaticResource ArabicActionButtonStyle}" Command="{Binding LoadCatalogueCommand}" />
                <Button Content="{StaticResource Ar.Command.Search}" Style="{StaticResource ArabicActionButtonStyle}" Command="{Binding LoadOrderCommand}" />
                <Button Content="{StaticResource Ar.Command.Print}" Style="{StaticResource ArabicActionButtonStyle}" Command="{Binding PreparePrintCommand}" />
                <Button Content="{StaticResource Ar.Command.Logout}"
                        Style="{StaticResource ArabicActionButtonStyle}"
                        Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
