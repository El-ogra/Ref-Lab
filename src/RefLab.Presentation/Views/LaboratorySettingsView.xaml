<UserControl x:Class="RefLab.Presentation.Views.LaboratorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LaboratorySettingsViewModel}"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <TextBlock Text="{StaticResource Screen.LaboratorySettings}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock Text="{StaticResource Field.PaperSize}" Style="{StaticResource BaseTextStyle}" />
                <ComboBox Style="{StaticResource LabComboBoxStyle}" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:EnumSource.PaperSizeValues}" SelectedItem="{Binding PaperSize}" />
                <TextBlock Text="{StaticResource Field.ReportSequenceStart}" Style="{StaticResource BaseTextStyle}" />
                <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ReportSequenceStart, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Style="{StaticResource LabCheckBoxStyle}" Content="{StaticResource Field.IsBarcodeAutoCreated}" IsChecked="{Binding IsBarcodeAutoCreated}" />
                <CheckBox Style="{StaticResource LabCheckBoxStyle}" Content="{StaticResource Field.IsWorkSheetPrinted}" IsChecked="{Binding IsWorkSheetPrinted}" />
                <TextBlock Text="{StaticResource Field.HistoryDisplayMode}" Style="{StaticResource BaseTextStyle}" />
                <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding HistoryDisplayMode, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{StaticResource Field.DefaultAccountType}" Style="{StaticResource BaseTextStyle}" />
                <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding DefaultAccountType, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="{StaticResource Command.Save}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveAsyncCommand}" />
                <TextBlock Text="{StaticResource Field.ConnectionReceiptHeader}" Style="{StaticResource BaseTextStyle}" />
                <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ConnectionReceiptHeader, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{StaticResource Field.ConnectionReceiptFooter}" Style="{StaticResource BaseTextStyle}" />
                <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding ConnectionReceiptFooter, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="{StaticResource Command.Apply}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveConnectionReceiptAsyncCommand}" />
                <Button Content="{StaticResource Command.Refresh}" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadAsyncCommand}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
