<UserControl x:Class="RefLab.Presentation.Views.SendOutQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SendOutQueueViewModel}"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <TextBlock Text="{StaticResource Screen.SendOut}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel DockPanel.Dock="Top">
                        <CheckBox Style="{StaticResource LabCheckBoxStyle}" Content="Pending only" IsChecked="{Binding PendingOnly}" />
                        <Button Content="{StaticResource Command.Refresh}" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadCommand}" />
                    </StackPanel>
                    <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Column.DestinationLab}" Binding="{Binding DestinationLabName}" Width="*" />
                            <DataGridTextColumn Header="{StaticResource Column.Dispatched}" Binding="{Binding IsDispatched}" Width="80" />
                            <DataGridTextColumn Header="{StaticResource Column.Settled}" Binding="{Binding IsSettled}" Width="80" />
                            <DataGridTextColumn Header="{StaticResource Column.Status}" Binding="{Binding State}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{StaticResource Field.OrderId}" Style="{StaticResource BaseTextStyle}" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding OrderTestId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{StaticResource Field.DestinationLaboratory}" Style="{StaticResource BaseTextStyle}" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding DestinationLabName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{StaticResource Field.OutPrice}" Style="{StaticResource BaseTextStyle}" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}" Text="{Binding OutPrice, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{StaticResource Command.Add}" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateCommand}" />
                        <Button Content="{StaticResource Command.Confirm}" Style="{StaticResource ActionButtonStyle}" Command="{Binding DispatchCommand}" />
                        <Button Content="{StaticResource Command.Clear}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SettleCommand}" />
                    </StackPanel>
                    <TextBlock Text="{StaticResource Column.Sequence}" Style="{StaticResource HeadingTextStyle}" HorizontalAlignment="Left" />
                    <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding Dispositions}" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Column.Status}" Binding="{Binding Action}" Width="120" />
                            <DataGridTextColumn Header="{StaticResource Column.Date}" Binding="{Binding RecordedAt}" Width="140" />
                            <DataGridTextColumn Header="{StaticResource Column.Operator}" Binding="{Binding RecordedBy}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
