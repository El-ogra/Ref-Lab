<UserControl x:Class="RefLab.Presentation.Views.Controls.PatientPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PatientPanelViewModel}"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="{StaticResource PanelBrush}">

    <!--
        The Arabic patient panel.

        The panel is laid out right to left: the Arabic labels sit on the right
        and the fields on their left, which is how the reference product
        presented it. The identifier, the barcode and the amounts keep a left to
        right direction of their own, because the thirteen-character order
        identifier and the decimal amounts have to read unambiguously.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                The panel names itself on a header band. The band is right to
                left, like the panel it heads.
            -->
            <Border Grid.Row="0" Style="{StaticResource PanelHeaderBorderStyle}">
                <TextBlock Text="{StaticResource Ar.PatientPanel.Title}"
                           Style="{StaticResource BaseTextStyle}"
                           FontFamily="{StaticResource ArabicFontFamily}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FieldLabelBrush}"
                           TextAlignment="Center" />
            </Border>

            <!-- The order identity -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.ReservationNumber}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         IsReadOnly="True"
                         Text="{Binding LegacyIdentifier, Mode=OneWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.RecordStatus}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         IsReadOnly="True"
                         Text="{Binding RecordStatus, Mode=OneWay}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{StaticResource Ar.Command.Barcode}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         IsReadOnly="True"
                         Text="{Binding Barcode, Mode=OneWay}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{StaticResource Column.Currency}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         IsReadOnly="True"
                         Text="{Binding CurrencyCode, Mode=OneWay}" />
            </Grid>

            <!-- The patient identity -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Name}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Sex}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <!--
                    The sex is chosen from the recorded values with a radio
                    group, the way the reference system's own panel does. The
                    options are the English tokens the reference system shows
                    inside its Arabic panel.
                -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="PatientSex"
                                 Style="{StaticResource LabRadioButtonStyle}"
                                 Content="Male"
                                 IsChecked="{Binding Sex, Converter={StaticResource EnumEquals}, ConverterParameter=Male}" />
                    <RadioButton GroupName="PatientSex"
                                 Style="{StaticResource LabRadioButtonStyle}"
                                 Content="Female"
                                 IsChecked="{Binding Sex, Converter={StaticResource EnumEquals}, ConverterParameter=Female}" />
                    <RadioButton GroupName="PatientSex"
                                 Style="{StaticResource LabRadioButtonStyle}"
                                 Content="Unknown"
                                 IsChecked="{Binding Sex, Converter={StaticResource EnumEquals}, ConverterParameter=Unknown}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Age}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ArabicValueStyle}"
                             Width="70"
                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{StaticResource Ar.PatientPanel.Years}"
                               Style="{StaticResource ArabicFieldLabelStyle}"
                               Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Address}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.PhoneNumber}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Transfer}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <CheckBox Grid.Row="5" Grid.Column="1"
                          Style="{StaticResource LabCheckBoxStyle}"
                          HorizontalAlignment="Right"
                          IsChecked="{Binding IsVip}" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.NotificationState}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <ComboBox Grid.Row="6" Grid.Column="1"
                          Style="{StaticResource LabComboBoxStyle}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.Notes}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="7" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         AcceptsReturn="True"
                         Height="56"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding ReceptionNote, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.AccountHolderName}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="8" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         Text="{Binding ReferringPhysicianCode, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    The referring party.

                    The counterparty the laboratory received the order from. The
                    commission the laboratory pays is computed on the base
                    amount of the orders it received from that party, so the
                    code is recorded with the order when the order is created.
                -->
                <TextBlock Grid.Row="9" Grid.Column="0"
                           Text="{StaticResource Ar.PatientPanel.ReferringParty}"
                           Style="{StaticResource ArabicFieldLabelStyle}" />
                <TextBox Grid.Row="9" Grid.Column="1"
                         Style="{StaticResource ArabicValueStyle}"
                         FlowDirection="LeftToRight"
                         Text="{Binding ReferringPartyCode, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- The requested tests -->
            <TextBlock Grid.Row="3"
                       Text="{StaticResource Ar.PatientPanel.RequestedTests}"
                       Style="{StaticResource HeadingTextStyle}"
                       HorizontalAlignment="Right"
                       Margin="0,12,0,4" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{StaticResource Sample.Blood}" Style="{StaticResource BaseTextStyle}" Margin="8,2" />
                <TextBlock Text="{StaticResource Sample.Urine}" Style="{StaticResource BaseTextStyle}" Margin="8,2" />
                <TextBlock Text="{StaticResource Sample.Stool}" Style="{StaticResource BaseTextStyle}" Margin="8,2" />
                <TextBlock Text="{StaticResource Sample.Serum}" Style="{StaticResource BaseTextStyle}" Margin="8,2" />
                <TextBlock Text="{StaticResource Sample.CSF}" Style="{StaticResource BaseTextStyle}" Margin="8,2" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
