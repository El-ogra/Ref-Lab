<UserControl x:Class="RefLab.Presentation.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RefLab.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}"
             mc:Ignorable="d"
             FlowDirection="LeftToRight"
             Background="{StaticResource SurfaceBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ChromePanelStyle}">
            <TextBlock Text="{StaticResource Screen.Statistics}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Field.From}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}" Width="120" Text="{Binding From, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{StaticResource Field.To}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource LabTextBoxStyle}" Width="120" Text="{Binding To, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{StaticResource Command.Refresh}" Style="{StaticResource ActionButtonStyle}" Command="{Binding RunLaboratoryStatisticsCommand}" />
                    <Button Content="{StaticResource Command.Confirm}" Style="{StaticResource ActionButtonStyle}" Command="{Binding RunPerformanceStatisticsCommand}" />
                </StackPanel>

                <!--
                    The three indicators of the screen, each one a tile that
                    names itself on a caption band. The tiles are the shared
                    unit the statistics screen is built from.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}" Margin="0,0,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.ByMonth}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding ByMonth}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Period}" Binding="{Binding Period}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}" Margin="0,0,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.BySex}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding BySex}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Period}" Binding="{Binding Period}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.BySubGroup}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding BySubGroup}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Period}" Binding="{Binding Period}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--
                    The indicators the reference system documents: the patient
                    count for a year sorted by month and by sex, the request
                    rate of a test group and the number of samples received in
                    the year.
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}" Margin="0,0,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.ByYear}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding ByYear}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Period}" Binding="{Binding Period}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}" Margin="0,0,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.ByMonthAndSex}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding ByMonthAndSex}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Period}" Binding="{Binding Period}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}" Margin="0,0,4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.RequestRate}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding RequestRates}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Code}" Binding="{Binding SubGroupCode}" Width="70" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding RequestCount}" Width="70" />
                                    <DataGridTextColumn Header="{StaticResource Column.Rate}" Binding="{Binding RequestsPerPatient}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{StaticResource Panel.Statistics.SamplesByYear}"
                                       Style="{StaticResource MetricTileCaptionStyle}" />
                            <DataGrid Style="{StaticResource LabDataGridStyle}" ItemsSource="{Binding SamplesByYear}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Column.Year}" Binding="{Binding Year}" Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Column.Count}" Binding="{Binding SampleCount}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
